# ===== COPY THIS FILE TO ".env" AND FILL IN. NEVER COMMIT ".env". =====
# Values marked [SECRET] must never be shared, pasted into chat, or put in frontend code.

NODE_ENV=development
PORT=5000

# Public URLs (use "localhost", not "127.0.0.1", everywhere so cookies and callbacks match)
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
# Must equal the exact URL you open for the XAMPP test page (no query string)
XAMPP_TEST_URL=http://localhost/pl-auth-test/auth-test.html

# [SECRET] At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARS
SESSION_IDLE_MINUTES=15
SESSION_ABSOLUTE_HOURS=8

# ----- Google (Google Cloud Console > APIs & Services > Credentials) -----
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID          # public identifier
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET  # [SECRET]
# Comma-separated approved Google Workspace domains. LEAVE EMPTY until Packages IT confirms the real domain(s).
ALLOWED_GOOGLE_DOMAINS=
# DEVELOPMENT ONLY (ignored when NODE_ENV=production): exact test emails allowed to sign in with Google
DEV_ALLOWED_EMAILS=

# ----- Microsoft Entra ID (Entra admin center > App registrations) -----
MS_CLIENT_ID=REPLACE_WITH_APPLICATION_CLIENT_ID         # public identifier
MS_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET_VALUE       # [SECRET] the secret VALUE, not the secret ID
MS_TENANT_ID=REPLACE_WITH_DIRECTORY_TENANT_ID           # identifier of the allowed organization (GUID)

# ----- Roles (demo of authorization after login) -----
# Comma-separated "provider:email" entries that get the "admin" role, e.g. google:someone@example.com
ADMIN_USERS=
